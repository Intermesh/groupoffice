{
  "type": "module",
  "name": "@intermesh/community-tasks",
  "exports": {
    ".": {
      "types": "./script/Index.ts",
      "default": "./dist/Index.js"
    }
  },
  "description": "GroupOffice Tasks module",
  "devDependencies": {
    "concurrently": "latest",
    "esbuild": "latest",
    "sass": "latest",
    "typescript": "5.9.*"
  },
  "scripts": {
    "start tasks": "concurrently --kill-others \"npm run start:ts\" ",
    "start:ts": "node ../../../../../../views/goui/esbuild-module.mjs watch",
    "start:dts": "npx tsc -b --declaration --emitDeclarationOnly --watch",

    "build": "npm run build:ts",
    "build:clean": "rm -rf ./dist/*",
    "build:ts": "node ../../../../../../views/goui/esbuild-module.mjs",
    "build:dts": "npx tsc -b --declaration --emitDeclarationOnly",

    "test": "npx tsc --noEmit",
    "prepare": "npm run build"
  }
}