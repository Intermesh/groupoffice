# Copy to config.sh to override the defaults in build.sh for this machine

# GitHub token for creating releases, if you don't want to use "gh auth login".
# Fine-grained token for Intermesh/groupoffice with permission Contents: Read and write.
# export GH_TOKEN=""

# Docker Hub login for pushing the image, if you don't want to use "docker login".
# Create a personal access token with Read & Write access on hub.docker.com.
#DOCKER_USERNAME="intermesh"
#DOCKER_TOKEN="dckr_pat_..."

# Deploy key for the promodules, business and docker-groupoffice repositories, so the build doesn't need
# a forwarded SSH agent (which is gone in a detached screen). Create it without a passphrase:
#   ssh-keygen -t ed25519 -N "" -f ~/.ssh/groupoffice-build
# Add the public key as a deploy key to promodules and business on git.intermesh.nl (read only) and to
# Intermesh/docker-groupoffice on GitHub (Settings > Deploy keys) with "Allow write access", because the
# build commits the new version in the Dockerfile and pushes it.
#GIT_SSH_KEY="$HOME/.ssh/groupoffice-build"

#SF_USER="mschering"
#ENCODER=(/usr/local/share/sourceguardian/bin/sourceguardian --phpversion 8.2+)
#TEST_IMAGE="intermesh/groupoffice:latest"
#DOCKER_PLATFORMS="linux/amd64,linux/arm64"

# Mail the result of the build to this address. Empty to disable.
#NOTIFY_EMAIL="info@intermesh.nl"
