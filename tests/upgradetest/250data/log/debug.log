[2026-01-20 10:32:22][JMAP Debtor/countActions][log][go\modules\business\finance\controller\Debtor:165] 
        SELECT count(distinct biz.contactId) 
        FROM `business_finance_contact_business` `biz`
        INNER JOIN `business_finance_document` `doc` ON 
         doc.customerId = biz.contactId
        INNER JOIN `business_finance_book` `book` ON 
         book.id = doc.bookId AND book.businessId = biz.businessId AND book.type = 'salesinvoice'
        INNER JOIN `business_finance_document_item_group` `ig` ON 
         ig.documentId = doc.id
        INNER JOIN `business_finance_document_item` `item` ON 
         item.groupId = ig.id
        WHERE 
         (
        	 (
        		 doc.completedAt is null AND doc.expiresAt <= now() and biz.graceUntil < now()
        	)
        )
        HAVING
         sum(item.quantity * item.unitPrice) > 0
