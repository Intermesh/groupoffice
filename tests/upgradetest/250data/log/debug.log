        SELECT SQL_CALC_FOUND_ROWS t.*,s.name AS status_name,type.name AS type_name, te.name AS template_name, te.project_type AS template_type_id , cf.col_1, cf.col_2, cf.col_3, cf.col_12, cf.col_14, cf.col_15, cf.col_26, cf.col_18, cf.col_19, cf.col_161, cf.col_20, cf.col_27, cf.col_40, cf.col_42, cf.col_61, cf.col_105, cf.col_158, cf.col_128,
        `type`.`id` AS `type@id`,
        `type`.`name` AS `type@name`,
        `type`.`user_id` AS `type@user_id`,
        `type`.`acl_id` AS `type@acl_id`,
        `type`.`acl_book` AS `type@acl_book`
        FROM `pr2_projects` t 
        INNER JOIN `pr2_types` `type` ON (`type`.`id`=`t`.`type_id`) 
        LEFT JOIN `pr2_projects_custom_fields` cf ON cf.id=t.id 
        INNER JOIN core_acl_group ON (`t`.`acl_id` = core_acl_group.aclId AND core_acl_group.level>=10 AND core_acl_group.groupId IN (2,4,5,6,10,13,14,36)) 
        INNER JOIN `pr2_statuses` s  ON ( `s`.`id` = `t`.`status_id`)
        LEFT JOIN `pr2_templates` te  ON ( `te`.`id` = `t`.`template_id`)
        WHERE 1 
        AND ( `t`.`parent_project_id` = "0") AND ( `s`.`filterable` = "0" OR `s`.`id` IN ("7","8","5","2","3","1","6","4"))
        GROUP BY t.`id` 
        ORDER BY `name` DESC 
        LIMIT 0,50
